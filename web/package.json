{
  "name": "metal-atlas-web",
  "private": true,
  "description": "Front end of Metal Atlas: the map and the guessing game (TypeScript, bundled into map/site/app.js)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2024 --minify --sourcemap --outfile=../map/site/app.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck-lint-test": "npm run typecheck && npm run lint && npm run test",
    "check": "npm run format:check && npm run typecheck-lint-test"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
