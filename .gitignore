# What goes in the repo: the code, the tests and the README. The data lives in the `data` release
# (python -m metal_atlas data); everything below is generated, or a large local cache/download.

# generated publish folder (GitHub Actions builds it on every push)
map/public/

# the bundled front end (built from web/ by `npm run build`, in CI and locally)
map/site/app.js
map/site/app.js.map
web/node_modules/

# the site's generated data and the packed data snapshots: they live in the `data` release
map/site/*.json
!map/site/countries-50m.json
map/site/c/
map/site/r/
dist/

# raw downloads and intermediate data (hundreds of MB, thousands of files)
scraper/pages/
scraper/members/
scraper/itunes/
scraper/disco/
scraper/discographies.jsonl
scraper/discographies.log
map/reviews_pages/
map/reviews_new/
map/geo_dl/
map/regions_out/
map/reviews_by_band.json

# development environment
.venv/
.pytest_cache/

# logs, backups, system files
*.log
*.bak
*.tmp
.DS_Store
__pycache__/
